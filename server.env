# Server network configuration.
#
# LaunchServer reads only this file for its network configuration.
# Lines starting with # are comments.
#
# MESOS_TCP_PORT:
# TCP port opened by the server.
# Use the same value in client.env.
#
# MESOS_RMI_PORT:
# Port used to create the RMI registry.
# Use the same value in client.env.
#
# MESOS_RMI_OBJECT_PORT:
# Port used by exported server RMI objects.
# Remote clients must be able to reach this port too.
#
# MESOS_SERVER_RMI_HOST:
# Address that RMI writes inside the stubs exported by the server.
# Use localhost when server and client run on the same machine.
# Use the server IP address when clients connect from another device on the same network.

MESOS_TCP_PORT=12345
MESOS_RMI_PORT=1099
MESOS_RMI_OBJECT_PORT=1100
MESOS_SERVER_RMI_HOST=192.168.1.56

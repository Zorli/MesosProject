@startuml server-prelobby
!theme plain
top to bottom direction

skinparam classAttributeIconSize 0
skinparam defaultFontName "Segoe UI"
skinparam class {
  BackgroundColor White
  BorderColor #555
  ArrowColor #444
  FontSize 11
}
skinparam interface {
  BackgroundColor #D6EAF8
  BorderColor #2980B9
}
skinparam class<<dep>> {
  BackgroundColor #F0F0F0
  BorderColor #999
  FontStyle italic
}
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888
}

skinparam class<<controller>> {
  BackgroundColor #FDEBD0
  BorderColor #E67E22
}
skinparam class<<handler>> {
  BackgroundColor #FEF9E7
  BorderColor #F0A500
}
skinparam class<<service>> {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class<<factory>> {
  BackgroundColor #E8DAEF
  BorderColor #8E44AD
}
skinparam class<<mapper>> {
  BackgroundColor #F4F6F7
  BorderColor #95A5A6
}

' ─── SHARED DEPENDENCIES (nome only) ───────────────────────────────────────
package "shared" <<dep>> {
  class MessageRouter <<dep>>
  class ServerSessionRegistry <<dep>>
  hide MessageRouter members
  hide ServerSessionRegistry members
}

' ─── PRE-LOBBY DOMAIN ──────────────────────────────────────────────────────
package "pre-lobby" {

  class ServerController <<controller>> {
    <color:#C0392B>-</color> sessions: ServerSessionRegistry
    <color:#C0392B>-</color> serverModel: ServerModel
    <color:#C0392B>-</color> gameFactory: GameFactory
    <color:#C0392B>-</color> connectionLifecycle: ServerConnectionLifecycle
    <color:#C0392B>-</color> pingPongRoutine: PingPongRoutine
    <color:#C0392B>-</color> commandQueue: BlockingQueue<QueuedCommand>
    <color:#1E8449>+</color> ServerController(gameFactory: GameFactory, sessions: ServerSessionRegistry)
    <color:#1E8449>+</color> getSessionRegistry(): ServerSessionRegistry
    <color:#1E8449>+</color> enqueueMessage(cmd: QueuedCommand): void
    <color:#1E8449>+</color> run(): void
    <color:#1E8449>+</color> registerConnection(conn: ClientConnection): String
    <color:#1E8449>+</color> recordPong(sessionId: String): void
    <color:#1E8449>+</color> disconnectSession(sessionId: String): void
    <color:#1E8449>+</color> reportPhaseError(sessionId: String): void
    <color:#C0392B>-</color> authenticate(sessionId: String, nickname: String): void
    <color:#C0392B>-</color> listOpenLobbies(sessionId: String): void
    <color:#C0392B>-</color> createLobby(sessionId: String, capacity: int): void
    <color:#C0392B>-</color> joinLobby(sessionId: String, lobbyId: int): void
  }

  class ServerModel {
    <color:#C0392B>-</color> sessions: ServerSessionRegistry
    <color:#C0392B>-</color> payloadMapper: PreLobbyPayloadMapper
    <color:#C0392B>-</color> globalListeners: Map<String, Listener>
    <color:#1E8449>+</color> ServerModel(sessions: ServerSessionRegistry)
    <color:#1E8449>+</color> addGlobalListener(sessionId: String, listener: Listener): void
    <color:#1E8449>+</color> removeGlobalListener(sessionId: String): void
    <color:#1E8449>+</color> reportPhaseError(sessionId: String): void
    <color:#1E8449>+</color> reportJoinError(sessionId: String, message: String): void
    <color:#1E8449>+</color> authenticate(sessionId: String, nickname: String, view: Listener): boolean
    <color:#1E8449>+</color> listOpenLobbies(sessionId: String, view: Listener): void
    <color:#1E8449>+</color> createLobby(sessionId: String, capacity: int, view: Listener): Lobby
    <color:#1E8449>+</color> joinLobbyValidation(sessionId: String, view: Listener, lobbyId: int): boolean
    <color:#C0392B>-</color> sendUnicastError(sessionId: String, type: String, msg: String): void
    <color:#C0392B>-</color> ensureSessionCanEnterLobby(sessionId: String): void
    <color:#C0392B>-</color> requireNickname(sessionId: String): String
  }

  class PreLobbyPayloadMapper <<mapper>> {
    <color:#1E8449>+</color> authenticated(nickname: String): AuthenticationResultPayload
    <color:#1E8449>+</color> lobbyCreated(nickname: String, lobby: Lobby): LobbyUpdatePayload
    <color:#1E8449>+</color> lobbyList(lobbies: List<Lobby>): LobbyListPayload
    <color:#C0392B>-</color> fromLobby(event: LobbyEventType, nick: String, msg: String, lobby: Lobby): LobbyUpdatePayload
    <color:#C0392B>-</color> summary(lobby: Lobby): LobbySummaryPayload
  }

  class ServerConnectionLifecycle <<service>> {
    <color:#C0392B>-</color> sessions: ServerSessionRegistry
    <color:#C0392B>-</color> serverModel: ServerModel
    <color:#1E8449>+</color> ServerConnectionLifecycle(sessions: ServerSessionRegistry, model: ServerModel)
    <color:#1E8449>+</color> registerConnection(conn: ClientConnection): String
    <color:#1E8449>+</color> recordPong(sessionId: String): void
    <color:#1E8449>+</color> disconnectSession(sessionId: String): void
    <color:#1E8449>+</color> handleConnectionTimeout(sessionId: String): void
  }

  class PingPongRoutine <<service>> {
    <color:#C0392B>-</color> {static} PING_INTERVAL_SECONDS: long
    <color:#C0392B>-</color> sessions: ServerSessionRegistry
    <color:#C0392B>-</color> connectionLifecycle: ServerConnectionLifecycle
    <color:#C0392B>-</color> scheduler: ScheduledExecutorService
    <color:#1E8449>+</color> PingPongRoutine(sessions: ServerSessionRegistry, lifecycle: ServerConnectionLifecycle)
    <color:#1E8449>+</color> start(): void
    <color:#1E8449>+</color> stop(): void
    <color:#C0392B>-</color> tick(): void
  }
}

' ─── RELATIONSHIPS ─────────────────────────────────────────────────────────

' Controller owns its components
ServerController *-- ServerModel              : owns
ServerController *-- ServerConnectionLifecycle : owns
ServerController *-- PingPongRoutine          : owns

' Model owns mapper
ServerModel *-- PreLobbyPayloadMapper : owns

' Controller → shared dependencies
ServerController ..> MessageRouter        : uses >
ServerController ..> ServerSessionRegistry : uses >

' Model → shared dependency
ServerModel ..> ServerSessionRegistry : uses >

' Lifecycle and ping → shared
ServerConnectionLifecycle ..> ServerSessionRegistry : uses >
PingPongRoutine ..> ServerSessionRegistry : uses >


legend right
  <b>Visibilità metodi</b>
  ====
  <color:#1E8449>+</color> public
  <color:#C0392B>-</color> private
  <color:#E67E22>#</color> protected
  <color:#1F618D>~</color> package-private
endlegend
@enduml

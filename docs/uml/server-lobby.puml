@startuml server-lobby
!theme plain
top to bottom direction

skinparam classAttributeIconSize 0
skinparam defaultFontName "Segoe UI"
skinparam class {
  BackgroundColor White
  BorderColor #555
  ArrowColor #444
  FontSize 11
}
skinparam interface {
  BackgroundColor #D6EAF8
  BorderColor #2980B9
}
skinparam enum {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class<<dep>> {
  BackgroundColor #F0F0F0
  BorderColor #999
  FontStyle italic
}
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888
}

skinparam class<<controller>> {
  BackgroundColor #FDEBD0
  BorderColor #E67E22
}
skinparam class<<handler>> {
  BackgroundColor #FEF9E7
  BorderColor #F0A500
}
skinparam class<<service>> {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class<<factory>> {
  BackgroundColor #E8DAEF
  BorderColor #8E44AD
}
skinparam class<<mapper>> {
  BackgroundColor #F4F6F7
  BorderColor #95A5A6
}

skinparam linetype ortho

' ─── SHARED DEPENDENCIES (name only) ───────────────────────────────────────
package "shared" <<dep>> {
  class MessageRouter <<dep>>
  class ServerSessionRegistry <<dep>>
  hide MessageRouter members
  hide ServerSessionRegistry members
}

' ─── LOBBY DOMAIN ──────────────────────────────────────────────────────────
package "lobby" {

  class LobbyController <<controller>> {
    <color:#C0392B>-</color> lobby: Lobby
    <color:#C0392B>-</color> sessions: ServerSessionRegistry
    <color:#C0392B>-</color> gameFactory: GameFactory
    <color:#C0392B>-</color> lobbyPlayerFactory: LobbyPlayerFactory
    <color:#C0392B>-</color> commandQueue: BlockingQueue<QueuedCommand>
    <color:#1E8449>+</color> LobbyController(lobby: Lobby, sessions: ServerSessionRegistry, factory: GameFactory)
    <color:#1E8449>+</color> enqueueMessage(cmd: QueuedCommand): void
    <color:#1E8449>+</color> run(): void
    <color:#C0392B>-</color> joinUser(sessionId: String): void
    <color:#C0392B>-</color> exitLobby(sessionId: String): void
    <color:#C0392B>-</color> disconnectUser(sessionId: String): void
    <color:#C0392B>-</color> shouldDisposeEmptyLobby(): boolean
    <color:#C0392B>-</color> startLobby(sessionId: String): void
    <color:#C0392B>-</color> startNewMatch(): GameController
    <color:#C0392B>-</color> startGameWorker(gc: GameController): void
    <color:#C0392B>-</color> attachLobbySessionsToGame(gc: GameController): void
    <color:#C0392B>-</color> completeLobbyTransition(gc: GameController): void
    <color:#C0392B>-</color> startMatchCountdown(gc: GameController): void
    <color:#C0392B>-</color> reportPhaseError(sessionId: String): void
  }

  class Lobby {
    <color:#1E8449>+</color> {static} MIN_PLAYERS: int
    <color:#1E8449>+</color> {static} MAX_PLAYERS: int
    <color:#C0392B>-</color> id: int
    <color:#C0392B>-</color> capacity: int
    <color:#C0392B>-</color> players: List<String>
    <color:#C0392B>-</color> hostNickname: String
    <color:#C0392B>-</color> status: LobbyStatus
    <color:#C0392B>-</color> listeners: List<Listener>
    <color:#C0392B>-</color> payloadMapper: LobbyPayloadMapper
    <color:#1E8449>+</color> Lobby(id: int, hostNickname: String, capacity: int)
    <color:#1E8449>+</color> addListener(l: Listener): void
    <color:#1E8449>+</color> removeListener(l: Listener): void
    <color:#1E8449>+</color> startMatch(nickname: String): boolean
    <color:#1E8449>+</color> addPlayer(nickname: String, view: Listener): boolean
    <color:#1E8449>+</color> removePlayer(nickname: String, view: Listener): boolean
    <color:#1E8449>+</color> reportPhaseError(target: Listener): void
    <color:#1E8449>+</color> notifyPlayerJoined(nickname: String): void
    <color:#1E8449>+</color> notifyPlayerLeft(nickname: String, leaving: Listener): void
    <color:#1E8449>+</color> notifyMatchStarted(nickname: String, target: Listener): void
    <color:#1E8449>+</color> clearListeners(): void
    <color:#1E8449>+</color> getId(): int
    <color:#1E8449>+</color> getHostNickname(): String
    <color:#1E8449>+</color> getPlayers(): List<String>
    <color:#1E8449>+</color> getChosenCapacity(): int
    <color:#1E8449>+</color> getStatus(): LobbyStatus
    <color:#1E8449>+</color> hasPlayer(nickname: String): boolean
    <color:#1E8449>+</color> canBeJoinedBy(nickname: String): boolean
    <color:#1E8449>+</color> isHost(nickname: String): boolean
    <color:#1E8449>+</color> canStart(): boolean
    <color:#1E8449>+</color> isFull(): boolean
    <color:#1E8449>+</color> isEmpty(): boolean
    <color:#C0392B>-</color> startMatchInternal(nickname: String): void
    <color:#C0392B>-</color> addPlayerInternal(nickname: String): void
    <color:#C0392B>-</color> removePlayerInternal(nickname: String): void
    <color:#C0392B>-</color> executeLobbyAction(action: Runnable, errorTarget: Listener): boolean
    <color:#C0392B>-</color> notifyListeners(payload: Object): void
    <color:#C0392B>-</color> validateNickname(nickname: String): String
  }

  class LobbyPayloadMapper <<mapper>> {
    <color:#1E8449>+</color> lobbyJoined(nickname: String, lobby: Lobby): LobbyUpdatePayload
    <color:#1E8449>+</color> lobbyLeft(nickname: String, lobby: Lobby, lobbyId: int): LobbyUpdatePayload
    <color:#1E8449>+</color> lobbyStarted(nickname: String, lobby: Lobby): LobbyUpdatePayload
    <color:#C0392B>-</color> fromLobby(event: LobbyEventType, nick: String, msg: String, lobby: Lobby): LobbyUpdatePayload
  }

  class LobbyPlayerFactory <<factory>> {
    <color:#C0392B>-</color> {static} AVAILABLE_TOTEMS: List<TotemColor>
    <color:#1E8449>+</color> createPlayers(nicknames: List<String>): List<Player>
  }

  interface GameFactory {
    <color:#1E8449>+</color> createGame(players: List<Player>): Game
    <color:#1E8449>+</color> createGame(gameId: int, players: List<Player>): Game
  }

  enum LobbyStatus {
    OPEN
    FULL
    IN_GAME
  }
}

' ─── RELATIONSHIPS ─────────────────────────────────────────────────────────

' Controller owns components
LobbyController *-- Lobby              : owns
LobbyController *-- LobbyPlayerFactory : owns

' Controller depends on
LobbyController ..> GameFactory         : uses >
LobbyController ..> MessageRouter       : uses >
LobbyController ..> ServerSessionRegistry : uses >

' Lobby owns mapper
Lobby *-- LobbyPayloadMapper : owns

' Lobby has status
Lobby --> LobbyStatus : has >


legend right
  <b>Visibilità metodi</b>
  ====
  <color:#1E8449>+</color> public
  <color:#C0392B>-</color> private
  <color:#E67E22>#</color> protected
  <color:#1F618D>~</color> package-private
endlegend
@enduml

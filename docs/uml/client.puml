@startuml client
!theme plain
top to bottom direction

skinparam classAttributeIconSize 0
skinparam defaultFontName "Segoe UI"
skinparam class {
  BackgroundColor White
  BorderColor #555
  ArrowColor #444
  FontSize 11
}
skinparam interface {
  BackgroundColor #D6EAF8
  BorderColor #2980B9
}
skinparam enum {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888
}

skinparam class<<controller>> {
  BackgroundColor #FDEBD0
  BorderColor #E67E22
}
skinparam class<<handler>> {
  BackgroundColor #FEF9E7
  BorderColor #F0A500
}
skinparam class<<service>> {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class<<factory>> {
  BackgroundColor #E8DAEF
  BorderColor #8E44AD
}
skinparam class<<mapper>> {
  BackgroundColor #F4F6F7
  BorderColor #95A5A6
}

skinparam linetype ortho

' ─── ENTRY POINT ───────────────────────────────────────────────────────────
class LaunchClient {
  <color:#1E8449>+</color> {static} main(args: String[]): void
  <color:#C0392B>-</color> {static} chooseClientView(scanner: Scanner): ClientView
  <color:#C0392B>-</color> {static} chooseServerProxy(scanner: Scanner, view: ClientView, env: Map): ServerProxy
  <color:#C0392B>-</color> {static} resolveServerHost(env: Map): String
  <color:#C0392B>-</color> {static} resolveTcpPort(env: Map): int
  <color:#C0392B>-</color> {static} resolveRmiPort(env: Map): int
  <color:#C0392B>-</color> {static} resolveClientRmiHost(env: Map): String
  <color:#C0392B>-</color> {static} startClient(view: ClientView, proxy: ServerProxy): void
  <color:#C0392B>-</color> {static} loadEnvironmentFile(path: String): Map
}

' ─── PROXY LAYER ───────────────────────────────────────────────────────────
package "serverproxy" {
  interface ServerProxy {
    <color:#1E8449>+</color> isConnected(): boolean
    <color:#1E8449>+</color> authenticate(nickname: String): void
    <color:#1E8449>+</color> listLobbies(): void
    <color:#1E8449>+</color> createLobby(capacity: int): void
    <color:#1E8449>+</color> joinLobby(lobbyId: int): void
    <color:#1E8449>+</color> exitLobby(): void
    <color:#1E8449>+</color> startLobby(): void
    <color:#1E8449>+</color> moveTotem(tile: String): void
    <color:#1E8449>+</color> chooseCard(cardId: int): void
    <color:#1E8449>+</color> extraDraw(cardId: int): void
    <color:#1E8449>+</color> close(): void
  }

  class ServerProxyTCP <<service>> {
    <color:#C0392B>-</color> socket: Socket
    <color:#C0392B>-</color> writer: PrintWriter
    <color:#C0392B>-</color> clientView: ClientView
    <color:#C0392B>-</color> virtualServer: VirtualServerTCP
    <color:#C0392B>-</color> virtualServerThread: Thread
    <color:#1E8449>+</color> ServerProxyTCP(host: String, port: int, view: ClientView)
    <color:#1F618D>~</color> ServerProxyTCP(socket: Socket, view: ClientView)
    <color:#1E8449>+</color> waitForVirtualServer(): void
    <color:#1E8449>+</color> isConnected(): boolean
    <color:#1E8449>+</color> sendPong(): void
    <color:#1E8449>+</color> authenticate(nickname: String): void
    <color:#1E8449>+</color> listLobbies(): void
    <color:#1E8449>+</color> createLobby(capacity: int): void
    <color:#1E8449>+</color> joinLobby(lobbyId: int): void
    <color:#1E8449>+</color> exitLobby(): void
    <color:#1E8449>+</color> startLobby(): void
    <color:#1E8449>+</color> moveTotem(tile: String): void
    <color:#1E8449>+</color> chooseCard(cardId: int): void
    <color:#1E8449>+</color> extraDraw(cardId: int): void
    <color:#1E8449>+</color> close(): void
    <color:#1E8449>+</color> closeConnection(): void
    <color:#C0392B>-</color> send(msg: ClientMessage): void
    <color:#C0392B>-</color> notifyLocalError(code: String, msg: String): void
  }

  class ServerProxyRMI <<service>> {
    <color:#C0392B>-</color> serverStub: RmiServerService
    <color:#C0392B>-</color> callbackReceiver: VirtualServerRMI
    <color:#C0392B>-</color> connected: boolean
    <color:#1E8449>+</color> ServerProxyRMI(service: RmiConnectionService, view: ClientView)
    <color:#1F618D>~</color> ServerProxyRMI(service: RmiConnectionService, view: ClientView, export: boolean)
    <color:#1E8449>+</color> isConnected(): boolean
    <color:#1E8449>+</color> sendPong(): void
    <color:#1E8449>+</color> authenticate(nickname: String): void
    <color:#1E8449>+</color> listLobbies(): void
    <color:#1E8449>+</color> createLobby(capacity: int): void
    <color:#1E8449>+</color> joinLobby(lobbyId: int): void
    <color:#1E8449>+</color> exitLobby(): void
    <color:#1E8449>+</color> startLobby(): void
    <color:#1E8449>+</color> moveTotem(tile: String): void
    <color:#1E8449>+</color> chooseCard(cardId: int): void
    <color:#1E8449>+</color> extraDraw(cardId: int): void
    <color:#1E8449>+</color> close(): void
    <color:#C0392B>-</color> send(payload: ClientPayload): void
    <color:#C0392B>-</color> handleDisconnection(e: RemoteException): void
    <color:#C0392B>-</color> notifyLocalError(code: String, msg: String): void
    <color:#C0392B>-</color> ensureConnected(): boolean
  }
}

' ─── VIRTUAL SERVER LAYER ──────────────────────────────────────────────────
package "virtualserver" {
  interface VirtualServer {
    <color:#1E8449>+</color> handleMessage(msg: ServerMessage): void
    <color:#1E8449>+</color> handlePing(): void
    <color:#1E8449>+</color> close(): void
  }

  class VirtualServerTCP <<service>> {
    <color:#C0392B>-</color> socket: Socket
    <color:#C0392B>-</color> serverProxy: ServerProxyTCP
    <color:#C0392B>-</color> closeRequestedByClient: boolean
    <color:#C0392B>-</color> messageRouter: MessageRouter
    <color:#1E8449>+</color> VirtualServerTCP(socket: Socket, view: ClientView, proxy: ServerProxyTCP)
    <color:#1E8449>+</color> run(): void
    <color:#1E8449>+</color> requestCloseByClient(): void
    <color:#1E8449>+</color> handleMessage(msg: ServerMessage): void
    <color:#1E8449>+</color> handlePing(): void
    <color:#1E8449>+</color> close(): void
    <color:#C0392B>-</color> isCloseRequestedByClient(): boolean
    <color:#C0392B>-</color> readServerMessages(reader: BufferedReader): void
    <color:#C0392B>-</color> handleServerMessage(raw: String): void
    <color:#C0392B>-</color> buildServerMessage(type: ServerMessageType, el: JsonElement): ServerMessage
    <color:#C0392B>-</color> handleError(code: String, msg: String): void
    <color:#C0392B>-</color> handleError(payload: ErrorPayload): void
  }

  class VirtualServerRMI <<service>> {
    <color:#C0392B>-</color> messageRouter: MessageRouter
    <color:#C0392B>-</color> exported: boolean
    <color:#C0392B>-</color> serverProxy: ServerProxyRMI
    <color:#1E8449>+</color> VirtualServerRMI(view: ClientView)
    <color:#1F618D>~</color> VirtualServerRMI(view: ClientView, exported: boolean)
    <color:#1E8449>+</color> handleMessage(msg: ServerMessage): void
    <color:#1E8449>+</color> handlePing(): void
    <color:#1E8449>+</color> attachServerProxy(proxy: ServerProxyRMI): void
    <color:#1E8449>+</color> close(): void
  }
}

' ─── VIEW LAYER ────────────────────────────────────────────────────────────
package "view" {
  interface ClientView {
    <color:#1E8449>+</color> showError(payload: ErrorPayload): void
    <color:#1E8449>+</color> showAuthenticationResult(payload: AuthenticationResultPayload): void
    <color:#1E8449>+</color> showLobbyUpdate(payload: LobbyUpdatePayload): void
    <color:#1E8449>+</color> showLobbyList(payload: LobbyListPayload): void
    <color:#1E8449>+</color> showGameUpdate(payload: GamePayload): void
    <color:#1E8449>+</color> showFinalGameResult(payload: GamePayload): void
  }

  class MessageRouter <<service>> {
    <color:#C0392B>-</color> clientView: ClientView
    <color:#1E8449>+</color> MessageRouter(view: ClientView)
    <color:#1E8449>+</color> routeMessage(msg: ServerMessage): void
    <color:#C0392B>-</color> routeGameUpdate(payload: GamePayload): void
  }

  class TuiController <<controller>> {
    <color:#C0392B>-</color> scanner: Scanner
    <color:#C0392B>-</color> out: PrintStream
    <color:#C0392B>-</color> commandParser: TuiCommandParser
    <color:#C0392B>-</color> payloadRenderer: TuiPayloadRenderer
    <color:#C0392B>-</color> lastGamePayload: GamePayload
    <color:#C0392B>-</color> localNickname: String
    <color:#C0392B>-</color> serverProxy: ServerProxy
    <color:#1E8449>+</color> TuiController()
    <color:#1E8449>+</color> TuiController(scanner: Scanner, out: PrintStream)
    <color:#1E8449>+</color> attachServerProxy(proxy: ServerProxy): void
    <color:#1E8449>+</color> start(): void
    <color:#1E8449>+</color> showError(payload: ErrorPayload): void
    <color:#1E8449>+</color> showAuthenticationResult(payload: AuthenticationResultPayload): void
    <color:#1E8449>+</color> showLobbyUpdate(payload: LobbyUpdatePayload): void
    <color:#1E8449>+</color> showLobbyList(payload: LobbyListPayload): void
    <color:#1E8449>+</color> showGameUpdate(payload: GamePayload): void
    <color:#1E8449>+</color> showFinalGameResult(payload: GamePayload): void
    <color:#C0392B>-</color> handleInputLine(line: String): boolean
    <color:#C0392B>-</color> executeCommand(cmd: TuiCommand): boolean
    <color:#C0392B>-</color> closeServerProxy(): void
    <color:#C0392B>-</color> renderHelp(): void
    <color:#C0392B>-</color> render(text: String): void
    <color:#C0392B>-</color> renderPrompt(): void
    <color:#C0392B>-</color> printPrompt(): void
  }

  class GUIController <<controller>> {
    <color:#C0392B>-</color> serverProxy: ServerProxy
    <color:#C0392B>-</color> nickname: String
    <color:#C0392B>-</color> lastGamePayload: GamePayload
    <color:#C0392B>-</color> lastLobbyListPayload: LobbyListPayload
    <color:#C0392B>-</color> lastLobbyUpdatePayload: LobbyUpdatePayload
    <color:#1E8449>+</color> {static} FXML_RESOURCE: String
    <color:#1E8449>+</color> {static} CSS_RESOURCE: String
    <color:#1E8449>+</color> attachServerProxy(proxy: ServerProxy): void
    <color:#1E8449>+</color> start(): void
    <color:#1E8449>+</color> initialize(): void
    <color:#1E8449>+</color> showError(payload: ErrorPayload): void
    <color:#1E8449>+</color> showAuthenticationResult(payload: AuthenticationResultPayload): void
    <color:#1E8449>+</color> showLobbyUpdate(payload: LobbyUpdatePayload): void
    <color:#1E8449>+</color> showLobbyList(payload: LobbyListPayload): void
    <color:#1E8449>+</color> showGameUpdate(payload: GamePayload): void
  }

  package "tui" {
    class TuiCommandParser {
      <color:#1E8449>+</color> parse(line: String): TuiCommand
      <color:#C0392B>-</color> splitLineIntoWords(line: String): String[]
      <color:#C0392B>-</color> parseType(word: String): TuiCommandType
    }

    class TuiCommand {
      <color:#C0392B>-</color> type: TuiCommandType
      <color:#C0392B>-</color> argument: String
      <color:#1E8449>+</color> TuiCommand(type: TuiCommandType, argument: String)
      <color:#1E8449>+</color> type(): TuiCommandType
      <color:#1E8449>+</color> argument(): String
      <color:#1E8449>+</color> intArgument(): int
    }

    enum TuiCommandType {
      HELP
      AUTH
      LIST_LOBBIES
      CREATE_LOBBY
      JOIN_LOBBY
      QUIT_LOBBY
      START_LOBBY
      MOVE_TOTEM
      CHOOSE_CARD
      EXTRA_DRAW
      QUIT
      --
      <color:#C0392B>-</color> usage: String
      <color:#C0392B>-</color> argumentRequired: boolean
      <color:#C0392B>-</color> integerArgument: boolean
      <color:#1E8449>+</color> usage(): String
      <color:#1E8449>+</color> argumentRequired(): boolean
      <color:#1E8449>+</color> integerArgument(): boolean
    }

    class TuiPayloadRenderer {
      <color:#1E8449>+</color> renderError(e: ErrorPayload, g: GamePayload, nick: String): String
      <color:#1E8449>+</color> renderAuthenticationResult(p: AuthenticationResultPayload): String
      <color:#1E8449>+</color> renderLobbyUpdate(p: LobbyUpdatePayload): String
      <color:#1E8449>+</color> renderLobbyList(p: LobbyListPayload): String
      <color:#1E8449>+</color> renderGame(p: GamePayload, nick: String): String
      <color:#1E8449>+</color> renderFinalGameResult(p: GamePayload): String
      <color:#C0392B>-</color> appendPlayers(sb: StringBuilder, players: List): void
      <color:#C0392B>-</color> appendBoard(sb: StringBuilder, board: BoardPayload): void
      <color:#C0392B>-</color> formatCards(cards: List): String
      <color:#C0392B>-</color> formatOfferSpaces(spaces: List): String
      <color:#C0392B>-</color> formatStartingBlocks(blocks: List): String
      <color:#C0392B>-</color> formatModifier(val: int): String
      <color:#C0392B>-</color> valueOrDash(obj: Object): String
    }
  }
}

' ─── NOTES ──────────────────────────────────────────────────────────────────
note right of VirtualServerRMI : "implements RmiClientService\n(external RMI interface)"
note right of GUIController    : "Extends javafx.application.Application.\nContains FXML-injected UI nodes\nand ~80 private render helpers."

' ─── RELATIONSHIPS ─────────────────────────────────────────────────────────

' Entry point
LaunchClient ..> ServerProxy : creates >
LaunchClient ..> ClientView  : creates >

' Proxy hierarchy
ServerProxy <|.. ServerProxyTCP
ServerProxy <|.. ServerProxyRMI

' Virtual server hierarchy
VirtualServer <|.. VirtualServerTCP

' View hierarchy
ClientView <|.. TuiController
ClientView <|.. GUIController

' Proxy ↔ VirtualServer compositions
ServerProxyTCP *-- VirtualServerTCP : owns
ServerProxyRMI *-- VirtualServerRMI : owns

' VirtualServer → MessageRouter
VirtualServerTCP *-- MessageRouter : owns
VirtualServerRMI *-- MessageRouter : owns

' MessageRouter → ClientView
MessageRouter --> ClientView : routes to >

' TUI internal
TuiController *-- TuiCommandParser : owns
TuiController *-- TuiPayloadRenderer : owns
TuiCommandParser ..> TuiCommand : creates >
TuiCommand --> TuiCommandType : uses >


legend right
  <b>Visibilità metodi</b>
  ====
  <color:#1E8449>+</color> public
  <color:#C0392B>-</color> private
  <color:#E67E22>#</color> protected
  <color:#1F618D>~</color> package-private
endlegend
@enduml

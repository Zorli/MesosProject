@startuml client
!theme plain
top to bottom direction

skinparam classAttributeIconSize 0
skinparam defaultFontName "Segoe UI"
skinparam class {
  BackgroundColor White
  BorderColor #555
  ArrowColor #444
  FontSize 11
}
skinparam interface {
  BackgroundColor #D6EAF8
  BorderColor #2980B9
}
skinparam enum {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888
}

skinparam class<<controller>> {
  BackgroundColor #FDEBD0
  BorderColor #E67E22
}
skinparam class<<handler>> {
  BackgroundColor #FEF9E7
  BorderColor #F0A500
}
skinparam class<<service>> {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class<<factory>> {
  BackgroundColor #E8DAEF
  BorderColor #8E44AD
}
skinparam class<<mapper>> {
  BackgroundColor #F4F6F7
  BorderColor #95A5A6
}

skinparam linetype ortho

' ─── ENTRY POINT ───────────────────────────────────────────────────────────
class LaunchClient {
  <color:#1E8449>+</color> {static} main(args: String[]): void
  <color:#C0392B>-</color> {static} chooseClientView(scanner: Scanner): ClientView
  <color:#C0392B>-</color> {static} chooseServerProxy(scanner: Scanner, clientView: ClientView, environment: Map): ServerProxy
  <color:#C0392B>-</color> {static} resolveServerHost(environment: Map): String
  <color:#C0392B>-</color> {static} resolveTcpPort(environment: Map): int
  <color:#C0392B>-</color> {static} resolveRmiPort(environment: Map): int
  <color:#C0392B>-</color> {static} resolveClientRmiHost(environment: Map): String
  <color:#C0392B>-</color> {static} startClient(clientView: ClientView, serverProxy: ServerProxy): void
  <color:#C0392B>-</color> {static} loadEnvironmentFile(environmentFile: String): Map
}

' ─── PROXY LAYER ───────────────────────────────────────────────────────────
package "serverproxy" {
  interface ServerProxy {
    <color:#1E8449>+</color> isConnected(): boolean
    <color:#1E8449>+</color> authenticate(nickname: String): void
    <color:#1E8449>+</color> listLobbies(): void
    <color:#1E8449>+</color> createLobby(chosenCapacity: int): void
    <color:#1E8449>+</color> joinLobby(lobbyId: int): void
    <color:#1E8449>+</color> exitLobby(): void
    <color:#1E8449>+</color> startLobby(): void
    <color:#1E8449>+</color> moveTotem(tile: String): void
    <color:#1E8449>+</color> chooseCard(cardId: int): void
    <color:#1E8449>+</color> extraDraw(cardId: int): void
    <color:#1E8449>+</color> close(): void
  }

  class ServerProxyTCP <<service>> {
    <color:#C0392B>-</color> socket: Socket
    <color:#C0392B>-</color> writer: PrintWriter
    <color:#C0392B>-</color> clientView: ClientView
    <color:#C0392B>-</color> virtualServer: VirtualServerTCP
    <color:#C0392B>-</color> virtualServerThread: Thread
    <color:#1E8449>+</color> ServerProxyTCP(serverHost: String, port: int, clientView: ClientView)
    <color:#1F618D>~</color> ServerProxyTCP(socket: Socket, clientView: ClientView)
    <color:#1F618D>~</color> waitForVirtualServer(): void
    <color:#1E8449>+</color> isConnected(): boolean
    <color:#1E8449>+</color> sendPong(): void
    <color:#1E8449>+</color> authenticate(nickname: String): void
    <color:#1E8449>+</color> listLobbies(): void
    <color:#1E8449>+</color> createLobby(chosenCapacity: int): void
    <color:#1E8449>+</color> joinLobby(lobbyId: int): void
    <color:#1E8449>+</color> exitLobby(): void
    <color:#1E8449>+</color> startLobby(): void
    <color:#1E8449>+</color> moveTotem(tile: String): void
    <color:#1E8449>+</color> chooseCard(cardId: int): void
    <color:#1E8449>+</color> extraDraw(cardId: int): void
    <color:#1E8449>+</color> close(): void
    <color:#1E8449>+</color> closeConnection(): void
    <color:#C0392B>-</color> send(message: ClientMessage): void
    <color:#C0392B>-</color> notifyLocalError(code: String, message: String): void
  }

  class ServerProxyRMI <<service>> {
    <color:#C0392B>-</color> serverStub: RmiServerService
    <color:#C0392B>-</color> callbackReceiver: VirtualServerRMI
    <color:#C0392B>-</color> connected: boolean
    <color:#1E8449>+</color> ServerProxyRMI(connectionService: RmiConnectionService, clientView: ClientView)
    <color:#1F618D>~</color> ServerProxyRMI(connectionService: RmiConnectionService, clientView: ClientView, exportCallback: boolean)
    <color:#1E8449>+</color> isConnected(): boolean
    <color:#1E8449>+</color> sendPong(): void
    <color:#1E8449>+</color> authenticate(nickname: String): void
    <color:#1E8449>+</color> listLobbies(): void
    <color:#1E8449>+</color> createLobby(chosenCapacity: int): void
    <color:#1E8449>+</color> joinLobby(lobbyId: int): void
    <color:#1E8449>+</color> exitLobby(): void
    <color:#1E8449>+</color> startLobby(): void
    <color:#1E8449>+</color> moveTotem(tile: String): void
    <color:#1E8449>+</color> chooseCard(cardId: int): void
    <color:#1E8449>+</color> extraDraw(cardId: int): void
    <color:#1E8449>+</color> close(): void
    <color:#C0392B>-</color> send(message: ClientMessage): void
    <color:#C0392B>-</color> handleDisconnection(e: RemoteException): void
    <color:#C0392B>-</color> notifyLocalError(code: String, message: String): void
    <color:#C0392B>-</color> ensureConnected(): boolean
  }
}

' ─── VIRTUAL SERVER LAYER ──────────────────────────────────────────────────
package "virtualserver" {
  interface VirtualServer {
    <color:#1E8449>+</color> handleMessage(message: ServerMessage): void
    <color:#1E8449>+</color> handlePing(): void
    <color:#1E8449>+</color> close(): void
  }

  class VirtualServerTCP <<service>> {
    <color:#C0392B>-</color> socket: Socket
    <color:#C0392B>-</color> serverProxy: ServerProxyTCP
    <color:#C0392B>-</color> closeRequestedByClient: boolean
    <color:#C0392B>-</color> messageRouter: MessageRouter
    <color:#1E8449>+</color> VirtualServerTCP(socket: Socket, clientView: ClientView, serverProxy: ServerProxyTCP)
    <color:#1E8449>+</color> run(): void
    <color:#1E8449>+</color> requestCloseByClient(): void
    <color:#1E8449>+</color> handleMessage(message: ServerMessage): void
    <color:#1E8449>+</color> handlePing(): void
    <color:#1E8449>+</color> close(): void
    <color:#C0392B>-</color> isCloseRequestedByClient(): boolean
    <color:#C0392B>-</color> readServerMessages(reader: BufferedReader): void
    <color:#C0392B>-</color> handleServerMessage(serializedMessage: String): void
    <color:#C0392B>-</color> buildServerMessage(type: ServerMessageType, payload: JsonElement): ServerMessage
    <color:#C0392B>-</color> handleError(code: String, message: String): void
    <color:#C0392B>-</color> handleError(payload: ErrorPayload): void
  }

  class VirtualServerRMI <<service>> {
    <color:#C0392B>-</color> messageRouter: MessageRouter
    <color:#C0392B>-</color> exported: boolean
    <color:#C0392B>-</color> serverProxy: ServerProxyRMI
    <color:#1E8449>+</color> VirtualServerRMI(clientView: ClientView)
    <color:#1F618D>~</color> VirtualServerRMI(clientView: ClientView, exported: boolean)
    <color:#1E8449>+</color> handleMessage(message: ServerMessage): void
    <color:#1E8449>+</color> handlePing(): void
    <color:#1E8449>+</color> attachServerProxy(serverProxy: ServerProxyRMI): void
    <color:#1E8449>+</color> close(): void
  }
}

' ─── VIEW LAYER ────────────────────────────────────────────────────────────
package "view" {
  interface ClientView {
    <color:#1E8449>+</color> showError(payload: ErrorPayload): void
    <color:#1E8449>+</color> showAuthenticationResult(payload: AuthenticationResultPayload): void
    <color:#1E8449>+</color> showLobbyUpdate(payload: LobbyUpdatePayload): void
    <color:#1E8449>+</color> showLobbyList(payload: LobbyListPayload): void
    <color:#1E8449>+</color> showGameUpdate(payload: GamePayload): void
    <color:#1E8449>+</color> {default} showFinalGameResult(payload: GamePayload): void
  }

  class MessageRouter <<service>> {
    <color:#C0392B>-</color> clientView: ClientView
    <color:#1E8449>+</color> MessageRouter(clientView: ClientView)
    <color:#1E8449>+</color> routeMessage(message: ServerMessage): void
    <color:#C0392B>-</color> routeGameUpdate(payload: GamePayload): void
  }

  package "tui" {
    class TuiView <<view>> {
      <color:#C0392B>-</color> scanner: Scanner
      <color:#C0392B>-</color> out: PrintStream
      <color:#C0392B>-</color> commandParser: TuiCommandParser
      <color:#C0392B>-</color> payloadRenderer: TuiPayloadRenderer
      <color:#C0392B>-</color> lastGamePayload: GamePayload
      <color:#C0392B>-</color> localNickname: String
      <color:#C0392B>-</color> serverProxy: ServerProxy
      <color:#1E8449>+</color> TuiView()
      <color:#1E8449>+</color> TuiView(scanner: Scanner, out: PrintStream)
      <color:#1E8449>+</color> attachServerProxy(proxy: ServerProxy): void
      <color:#1E8449>+</color> start(): void
      <color:#1E8449>+</color> showError(payload: ErrorPayload): void
      <color:#1E8449>+</color> showAuthenticationResult(payload: AuthenticationResultPayload): void
      <color:#1E8449>+</color> showLobbyUpdate(payload: LobbyUpdatePayload): void
      <color:#1E8449>+</color> showLobbyList(payload: LobbyListPayload): void
      <color:#1E8449>+</color> showGameUpdate(payload: GamePayload): void
      <color:#1E8449>+</color> showFinalGameResult(payload: GamePayload): void
      <color:#C0392B>-</color> handleInputLine(line: String): boolean
      <color:#C0392B>-</color> executeCommand(command: TuiCommand): boolean
      <color:#C0392B>-</color> closeServerProxy(): void
      <color:#C0392B>-</color> renderHelp(): void
      <color:#C0392B>-</color> render(message: String): void
      <color:#C0392B>-</color> renderPrompt(): void
      <color:#C0392B>-</color> printPrompt(): void
    }

    class TuiCommandParser <<mapper>> {
      <color:#1F618D>~</color> parse(line: String): TuiCommand
      <color:#C0392B>-</color> {static} splitLineIntoWords(line: String): String[]
      <color:#C0392B>-</color> {static} parseType(keyword: String): TuiCommandType
    }

    class TuiCommand {
      <color:#C0392B>-</color> type: TuiCommandType
      <color:#C0392B>-</color> argument: String
      <color:#1F618D>~</color> TuiCommand(type: TuiCommandType, argument: String)
      <color:#1F618D>~</color> type(): TuiCommandType
      <color:#1F618D>~</color> argument(): String
      <color:#1F618D>~</color> intArgument(): int
    }

    enum TuiCommandType {
      HELP
      AUTH
      LIST_LOBBIES
      CREATE_LOBBY
      JOIN_LOBBY
      QUIT_LOBBY
      START_LOBBY
      MOVE_TOTEM
      CHOOSE_CARD
      EXTRA_DRAW
      QUIT
      --
      <color:#C0392B>-</color> usage: String
      <color:#C0392B>-</color> argumentRequired: boolean
      <color:#C0392B>-</color> integerArgument: boolean
      <color:#1F618D>~</color> usage(): String
      <color:#1F618D>~</color> argumentRequired(): boolean
      <color:#1F618D>~</color> integerArgument(): boolean
    }

    class TuiPayloadRenderer <<mapper>> {
      <color:#1F618D>~</color> renderError(payload: ErrorPayload, lastGamePayload: GamePayload, localNickname: String): String
      <color:#1F618D>~</color> renderAuthenticationResult(payload: AuthenticationResultPayload): String
      <color:#1F618D>~</color> renderLobbyUpdate(payload: LobbyUpdatePayload): String
      <color:#1F618D>~</color> renderLobbyList(payload: LobbyListPayload): String
      <color:#1F618D>~</color> renderGame(payload: GamePayload, localNickname: String): String
      <color:#1F618D>~</color> renderFinalGameResult(payload: GamePayload): String
      <color:#C0392B>-</color> {static} appendPlayers(builder: StringBuilder, players: List): void
      <color:#C0392B>-</color> {static} appendBoard(builder: StringBuilder, board: BoardPayload): void
      <color:#C0392B>-</color> {static} formatCards(cards: List): String
      <color:#C0392B>-</color> {static} formatOfferSpaces(offerSpaces: List): String
      <color:#C0392B>-</color> {static} formatStartingBlocks(startingBlocks: List): String
      <color:#C0392B>-</color> {static} formatModifier(value: int): String
      <color:#C0392B>-</color> {static} valueOrDash(value: Object): String
    }
  }

  package "gui" {
    class GUIView <<view>> {
      <color:#C0392B>-</color> serverProxy: ServerProxy
      <color:#C0392B>-</color> nickname: String
      <color:#C0392B>-</color> lastGamePayload: GamePayload
      <color:#C0392B>-</color> lastLobbyListPayload: LobbyListPayload
      <color:#C0392B>-</color> lastLobbyUpdatePayload: LobbyUpdatePayload
      <color:#C0392B>-</color> {static} FXML_RESOURCE: String
      <color:#C0392B>-</color> {static} CSS_RESOURCE: String
      <color:#1E8449>+</color> attachServerProxy(proxy: ServerProxy): void
      <color:#1E8449>+</color> start(): void
      <color:#1E8449>+</color> start(stage: Stage): void
      <color:#C0392B>-</color> initialize(): void
      <color:#1E8449>+</color> showError(payload: ErrorPayload): void
      <color:#1E8449>+</color> showAuthenticationResult(payload: AuthenticationResultPayload): void
      <color:#1E8449>+</color> showLobbyUpdate(payload: LobbyUpdatePayload): void
      <color:#1E8449>+</color> showLobbyList(payload: LobbyListPayload): void
      <color:#1E8449>+</color> showGameUpdate(payload: GamePayload): void
    }
  }
}

' ─── NOTES ──────────────────────────────────────────────────────────────────
note right of VirtualServerRMI : "implements RmiClientService\n(external RMI interface)"
note right of GUIView          : "Controls FXML-injected UI nodes\nand ~80 private render helpers."

' ─── RELATIONSHIPS ─────────────────────────────────────────────────────────

' Entry point
LaunchClient ..> ServerProxy : <<create>>
LaunchClient ..> ClientView  : <<create>>

' Proxy hierarchy
ServerProxy <|.. ServerProxyTCP
ServerProxy <|.. ServerProxyRMI

' Virtual server hierarchy
VirtualServer <|.. VirtualServerTCP

' View hierarchy
ClientView <|.. TuiView
ClientView <|.. GUIView

' Proxy ↔ VirtualServer compositions
ServerProxyTCP *-- VirtualServerTCP : owns
ServerProxyRMI *-- VirtualServerRMI : owns

' VirtualServer → MessageRouter
VirtualServerTCP *-- MessageRouter : owns
VirtualServerRMI *-- MessageRouter : owns

' MessageRouter → ClientView
MessageRouter --> ClientView : routes to 

' TUI internal
TuiView *-- TuiCommandParser : owns
TuiView *-- TuiPayloadRenderer : owns
TuiCommandParser ..> TuiCommand : <<create>>
TuiCommand --> TuiCommandType : uses 


legend right
  <b>Legenda Colori</b>
  |<back:#FDEBD0>      </back> <b>Controller</b> | Controller delle sessioni, lobby o gioco (gestione input/comandi) |
  |<back:#D5F5E3>      </back> <b>Service</b> | Routine di background, lifecycle o proxy di rete |
  |<back:#FEF9E7>      </back> <b>Handler</b> | Gestori specifici delle regole di gioco o degli eventi interni |
  |<back:#E8DAEF>      </back> <b>Factory</b> | Classi factory per la creazione di entità |
  |<back:#F4F6F7>      </back> <b>Mapper</b> | Classi di mapping e traduzione payload |
  |<back:#EBF5FB>      </back> <b>Network</b> | Entrypoint di rete e stubs di comunicazione |
  |<back:#E8F8F5>      </back> <b>VirtualView</b> | Rappresentazione virtuale del client sul server |
  |<back:#D6EAF8>      </back> <b>Interface</b> | Interfacce di sistema o callback |
  |<back:#FFFFFF>      </back> <b>Entity/Model</b> | Classi di dati e value objects |
  ====
  <b>Visibilità metodi</b>
  ====
  <color:#1E8449>+</color> public
  <color:#C0392B>-</color> private
  <color:#E67E22>#</color> protected
  <color:#1F618D>~</color> package-private
endlegend
@enduml

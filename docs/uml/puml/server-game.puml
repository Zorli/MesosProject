@startuml server-game
!theme plain
left to right direction

skinparam classAttributeIconSize 0
skinparam defaultFontName "Segoe UI"
skinparam class {
  BackgroundColor White
  BorderColor #475569
  ArrowColor #444
  FontSize 10
}
skinparam abstract {
  BackgroundColor #F8FAFC
  BorderColor #64748B
}
skinparam interface {
  BackgroundColor #D6EAF8
  BorderColor #2980B9
}
skinparam enum {
  BackgroundColor #ECFEFF
  BorderColor #0891B2
}
skinparam class<<dep>> {
  BackgroundColor #F0F0F0
  BorderColor #999
  FontStyle italic
}
skinparam class<<internal>> {
  BackgroundColor #F8FAFC
  BorderColor #CBD5E1
}
skinparam packageStyle rectangle
skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #888
  FontSize 11
}

skinparam class<<controller>> {
  BackgroundColor #FDEBD0
  BorderColor #E67E22
}
skinparam class<<handler>> {
  BackgroundColor #FEF9E7
  BorderColor #F0A500
}
skinparam class<<service>> {
  BackgroundColor #D5F5E3
  BorderColor #27AE60
}
skinparam class<<factory>> {
  BackgroundColor #E8DAEF
  BorderColor #8E44AD
}
skinparam class<<mapper>> {
  BackgroundColor #F4F6F7
  BorderColor #95A5A6
}
skinparam class<<model>> {
  BackgroundColor #D6F5F5
  BorderColor #1A9999
}
skinparam abstract<<model>> {
  BackgroundColor #D6F5F5
  BorderColor #1A9999
}

skinparam linetype ortho

' ─── SHARED DEPENDENCIES (name only) ───────────────────────────────────────
package "shared" <<dep>> {
  class MessageRouter <<dep>>
  class ServerSessionRegistry <<dep>>
  hide MessageRouter members
  hide ServerSessionRegistry members
}


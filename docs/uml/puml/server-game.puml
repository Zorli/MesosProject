' ═══ RELATIONSHIPS ══════════════════════════════════════════════════════════

' ─── Controller ─────────────────────────────────────────────────────────────
GameController *-- Game             : owns
MessageRouter -right..> GameController    : uses 
GameController -left..> ServerSessionRegistry : uses 

' ─── Game → handlers (composition) ─────────────────────────────────────────
Game *-- GameActionExecutor          : owns
Game *-- CardDraftHandler            : owns
Game *-- TotemPlacementHandler       : owns
Game *-- PassiveRoundPhaseHandler    : owns
Game *-- Board                       : owns
Game *-- RoundFlow                   : owns
Game *-- PlayerDraftState            : owns
Game ..> GamePayloadMapper           : uses 
Game o-- "1..*" Player               : contains

' ─── Player → Tribe ──────────────────────────────────────────────────────────
Player *-- Tribe                     : owns

' ─── Tribe → cards ───────────────────────────────────────────────────────────
Tribe o-- "1..*" CharacterCard       : has
Tribe o-- "*" BuildingCard           : has

' ─── Board → piles / offerpath ───────────────────────────────────────────────
Board *-- UpperPile                  : owns
Board *-- LowerPile                  : owns
Board *-- OfferPath                  : owns

' ─── OfferPath → sub-components ─────────────────────────────────────────────
OfferPath *-- StartingTile           : owns
OfferPath o-- "1..*" OfferSpace      : contains

' ─── StartingTile → StartingBlock ────────────────────────────────────────────
StartingTile o-- "1..*" StartingBlock : contains

' ─── Card hierarchy ──────────────────────────────────────────────────────────
CardAction <|.. Card
Card <|-- BuildingCard
Card <|-- TribeCard
TribeCard <|-- CharacterCard
TribeCard <|-- EventCard
EventAction <|.. EventCard

' Character subclasses
CharacterCard <|-- Artist
CharacterCard <|-- Builder
CharacterCard <|-- Gatherer
CharacterCard <|-- Hunter
CharacterCard <|-- Inventor
CharacterCard <|-- Shaman

' Building subclasses
BuildingCard <|-- BigPpReward
BuildingCard <|-- CavePaintingBonus
BuildingCard <|-- HunterBonus
BuildingCard <|-- MultiplierForType
BuildingCard <|-- PairOfInventor
BuildingCard <|-- PrestigePointsForSet
BuildingCard <|-- SetForFood
BuildingCard <|-- ShamanStarsBonus
BuildingCard <|-- SustenanceDiscount

' Event subclasses
EventCard <|-- CavePaintingEventCard
EventCard <|-- HuntEventCard
EventCard <|-- ShamanRitualEventCard
EventCard <|-- SustenanceEventCard

' Deck hierarchy
Deck <|-- BuildingDeck
Deck <|-- TribeDeck


legend right
  <b>Legenda Colori</b>
  |<back:#EFF6FF>      </back> <b>Controller</b> | Controller delle sessioni, lobby o gioco (gestione input/comandi) |
  |<back:#F5F3FF>      </back> <b>Service</b> | Routine di background, lifecycle o proxy di rete |
  |<back:#FEF9E7>      </back> <b>Handler</b> | Gestori specifici delle regole di gioco o degli eventi interni |
  |<back:#FDF2F8>      </back> <b>Factory</b> | Classi factory per la creazione di entità |
  |<back:#FAF5FF>      </back> <b>Mapper</b> | Classi di mapping e traduzione payload |
  |<back:#F0FDF4>      </back> <b>Interface</b> | Interfacce di sistema o callback |
  |<back:#FFF7ED>      </back> <b>Enum</b> | Classi enum di tipologia o stato |
  |<back:#D6F5F5>      </back> <b>Model</b> | Entità del dominio (dati e stato di gioco) |
  |<back:#F1F5F9>      </back> <b>Dependency</b> | Dipendenze esterne (solo nome classe) |
  ====
  <b>Visibilità metodi</b>
  ====
  <color:#1E8449>+</color> public
  <color:#C0392B>-</color> private
  <color:#E67E22>#</color> protected
  <color:#1F618D>~</color> package-private
endlegend
@enduml

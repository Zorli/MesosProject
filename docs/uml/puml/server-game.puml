  <color:#C0392B>-</color> extraDrawn(player: Player, cardId: int): void
  <color:#C0392B>-</color> closeGame(): void
  <color:#C0392B>-</color> resolvePlayer(nickname: String): Player
  <color:#C0392B>-</color> resolvePlayerBySession(sessionId: String): Player

      "x": -7344.787972958404,
      "y": 11793.250088300687,
      "width": 4400.466796875,
      "height": 1542.8619032997967,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",

      "updated": 1779951388791,
      "link": null,
      "locked": false,
      "text": "RMI nasconde socket\ne serializzazione,\nma usa comunque la rete TCP/IP",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "RMI nasconde socket\ne serializzazione,\nma usa comunque la rete TCP/IP",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "b3r"
    },
    {
      "id": "rmi-concrete-summary-box",

# =============================================================================
# Mesos — server environment configuration
# =============================================================================
# Copia questo file in .env e personalizza i valori.
#   cp .env.server.example .env
#
# Il file .env viene letto automaticamente all'avvio del server.
# Le variabili di shell hanno sempre la precedenza sul file.
# Il file .env è escluso da git (vedi .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------

# Imposta su true per avviare senza Postgres (nessun docker necessario).
# Quando abilitato il ranking non viene salvato.
MESOS_NO_DB=false

# URL JDBC del database di gioco
MESOS_DB_URL=jdbc:postgresql://localhost:5432/mesos

# URL JDBC del database amministrativo (usato per creare lo schema al primo avvio)
MESOS_DB_ADMIN_URL=jdbc:postgresql://localhost:5432/postgres

# Credenziali database
MESOS_DB_USER=postgres
MESOS_DB_PASSWORD=postgres

# Numero massimo di retry su errori transitori
MESOS_DB_MAX_BUSY_RETRIES=3

# Variabili per docker-compose (usate dal compose file, non direttamente dal server)
MESOS_POSTGRES_DB=mesos
MESOS_POSTGRES_USER=postgres
MESOS_POSTGRES_PASSWORD=postgres
MESOS_POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Persistenza partite (checkpoint JSON su disco)
# -----------------------------------------------------------------------------

# Abilita/disabilita il salvataggio delle partite su disco.
# Con true il server riprende le partite in corso dopo un riavvio.
MESOS_GAME_PERSISTENCE_ENABLED=true

# Directory in cui salvare i file di checkpoint (relativa alla root del progetto)
MESOS_GAME_PERSISTENCE_DIR=data/game-checkpoints

# -----------------------------------------------------------------------------
# Rete
# -----------------------------------------------------------------------------

# Porta TCP su cui il server accetta connessioni dai client
MESOS_TCP_PORT=12345

# Porta RMI
MESOS_RMI_PORT=1099

# =============================================================================
# Mesos — server environment configuration
# =============================================================================
# Copia questo file in .env e personalizza i valori.
#   cp .env.server.example .env
#
# Il file .env viene letto automaticamente all'avvio del server.
# Le variabili di shell hanno sempre la precedenza sul file.
# Il file .env è escluso da git (vedi .gitignore).
# =============================================================================

# Abilita/disabilita il salvataggio delle partite su disco.
# Con true il server riprende le partite in corso dopo un riavvio.
MESOS_GAME_PERSISTENCE_ENABLED=true

# Directory in cui salvare i file di checkpoint (relativa alla root del progetto)
MESOS_GAME_PERSISTENCE_DIR=data/game-checkpoints

# -----------------------------------------------------------------------------
# Rete
# -----------------------------------------------------------------------------

# Porta TCP su cui il server accetta connessioni dai client
MESOS_TCP_PORT=12345

# Porta RMI
MESOS_RMI_PORT=1099

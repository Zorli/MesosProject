# Server runtime variables. Keep these aligned with MESOS_MYSQL_* if you change
# the local Compose database name, port, or password.
MESOS_DB_URL=jdbc:mysql://localhost:3306/mesos?connectionTimeZone=UTC&allowPublicKeyRetrieval=true&useSSL=false
MESOS_DB_ADMIN_URL=jdbc:mysql://localhost:3306/mysql?connectionTimeZone=UTC&allowPublicKeyRetrieval=true&useSSL=false
MESOS_DB_USER=root
MESOS_DB_PASSWORD=root
MESOS_DB_MAX_BUSY_RETRIES=3
MESOS_NO_DB=false

# Docker Compose variables for the local MySQL container.
MESOS_MYSQL_DB=mesos
MESOS_MYSQL_ROOT_PASSWORD=root
MESOS_MYSQL_PORT=3306

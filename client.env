# Client network configuration.
# MESOS_SERVER_HOST is the machine where LaunchServer is running.
# It has to match what is configured in the server.env
MESOS_SERVER_HOST=localhost
MESOS_TCP_PORT=89
MESOS_RMI_PORT=1099

# Used by RMI clients to expose the callback address that the server calls.
# If the client uses TCP, this value is ignored.
MESOS_CLIENT_RMI_HOST=localhost

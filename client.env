# Client network configuration.
#
# LaunchClient reads only this file for its network configuration.
# Lines starting with # are comments.
#
# MESOS_SERVER_HOST:
# Address of the machine where LaunchServer is running.
# Use localhost when client and server run on the same machine.
# Use the server IP address when connecting from another device on the same network.
MESOS_SERVER_HOST=localhost

# MESOS_TCP_PORT:
# TCP port of the server.
# It must match MESOS_TCP_PORT in server.env.
MESOS_TCP_PORT=12345

# MESOS_RMI_PORT:
# RMI registry port of the server.
# It must match MESOS_RMI_PORT in server.env.
MESOS_RMI_PORT=1099

# MESOS_CLIENT_RMI_HOST:
# Address of this client, used only with RMI callbacks.
# Use localhost when client and server run on the same machine.
# Use the client IP address when server and client run on different devices.
# If the client uses TCP, this value is ignored.
MESOS_CLIENT_RMI_HOST=localhost

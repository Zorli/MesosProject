package it.polimi.ingsoft.mesos.server.model.game.game.enums {
  enum DraftTurnState {
    TURN_COMPLETED
    WAITING_FOR_CARD_SELECTION
  }
  enum RoundPhase {
    PLACING_TOTEMS
    PLAYER_DRAWS
    EXTRA_DRAWS

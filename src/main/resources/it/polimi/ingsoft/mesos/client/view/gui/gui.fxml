<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="app-shell"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" spacing="18" styleClass="top-bar">
            <padding>
                <Insets top="16" right="28" bottom="16" left="28"/>
            </padding>
            <VBox spacing="0">
                <Label text="MESOS" styleClass="brand-title"/>
                <Label text="desktop command table" styleClass="brand-subtitle"/>
            </VBox>
            <HBox spacing="8" styleClass="nav-rail">
                <Label text="Login" styleClass="nav-chip"/>
                <Label text="Lobby" styleClass="nav-chip"/>
                <Label text="Match" styleClass="nav-chip"/>
                <Label text="Ranking" styleClass="nav-chip"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="session" styleClass="muted"/>
            <Label fx:id="sessionNicknameLabel" text="Guest" styleClass="session-pill"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="pages" styleClass="page-stack">
            <StackPane fx:id="loginPage" styleClass="login-page">
                <HBox alignment="CENTER" spacing="34" styleClass="login-overlay">
                    <VBox alignment="CENTER" spacing="16" minWidth="410" maxWidth="450" minHeight="0" maxHeight="310" styleClass="login-panel">
                        <VBox alignment="CENTER" spacing="6">
                            <Label text="User Login" styleClass="panel-title-large"/>

                        </VBox>
                        <Region maxWidth="92" minHeight="2" prefHeight="2" styleClass="login-divider"/>
                        <Label text="Nickname" maxWidth="Infinity" styleClass="field-label"/>
                        <TextField fx:id="nicknameField"
                                   promptText="es. Tartufo"
                                   onAction="#handleLogin"
                                   styleClass="text-input"/>
                        <Button text="Log in" maxWidth="Infinity" onAction="#handleLogin" styleClass="primary-button"/>
                        <Label fx:id="loginStatusLabel" text="" wrapText="true" styleClass="status-text"/>
                    </VBox>
                </HBox>
            </StackPane>

            <VBox fx:id="lobbyPage" spacing="18" styleClass="page lobby-page">
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="screen-header">
                    <VBox spacing="2">
                        <Label text="Active lobbies" styleClass="section-title"/>
                        <Label fx:id="lobbyStatusLabel" text="Choose an open table or create your own lobby." styleClass="section-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lobbyCountLabel" text="0 tables" styleClass="session-pill"/>
                    <Button text="Ranking" onAction="#handleRanking" styleClass="ghost-button"/>
                </HBox>

                <HBox spacing="18" VBox.vgrow="ALWAYS">
                    <VBox spacing="14" styleClass="surface-panel list-panel" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label text="Available tables" styleClass="panel-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <ScrollPane fx:id="lobbyScrollPane" fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="clean-scroll">
                            <VBox fx:id="lobbyListContainer" spacing="12"/>
                        </ScrollPane>
                    </VBox>

                    <VBox spacing="16" minWidth="316" prefWidth="340" styleClass="surface-panel command-panel">
                        <VBox spacing="2">
                            <Label fx:id="lobbyActionTitleLabel" text="Create table" styleClass="panel-title-large"/>
                            <Label fx:id="lobbyActionSubtitleLabel" text="Pick a table size from 2 to 5 players and become the host." wrapText="true" styleClass="muted"/>
                        </VBox>
                        <VBox spacing="8" styleClass="current-lobby-panel">
                            <HBox alignment="CENTER_LEFT" spacing="8">
                                <Label fx:id="currentLobbyTitleLabel" text="No lobby selected" styleClass="current-lobby-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="currentLobbyStateLabel" text="Waiting" styleClass="status-pill"/>
                            </HBox>
                            <Label fx:id="currentLobbyHostLabel" text="Host: -" styleClass="muted"/>
                            <Label fx:id="currentLobbyPlayersLabel" text="Players: -" styleClass="muted"/>
                        </VBox>
                        <Label text="Players" styleClass="field-label"/>
                        <ComboBox fx:id="capacityComboBox" maxWidth="Infinity"/>
                        <Button fx:id="createLobbyButton" text="Create lobby" onAction="#handleCreateLobby" maxWidth="Infinity" styleClass="primary-button"/>
                        <Button fx:id="startLobbyButton"
                                text="Start match"
                                disable="true"
                                onAction="#handleStartLobby"
                                maxWidth="Infinity"
                                styleClass="secondary-button"/>
                        <Button fx:id="exitLobbyButton"
                                text="Exit lobby"
                                disable="true"
                                onAction="#handleExitLobby"
                                maxWidth="Infinity"
                                styleClass="danger-button"/>
                    </VBox>
                </HBox>
            </VBox>

            <VBox fx:id="gamePage" spacing="14" styleClass="page game-page">
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="screen-header">
                    <VBox spacing="2">
                        <Label fx:id="matchTitleLabel" text="Partita" styleClass="section-title"/>
                        <Label fx:id="matchMetaLabel" text="Era - / stato -" styleClass="section-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="turnLabel" text="Turno in attesa" styleClass="turn-pill"/>
                    <Button text="Fine mock" onAction="#handleMockEndMatch" styleClass="ghost-button"/>
                </HBox>

                <HBox spacing="16" VBox.vgrow="ALWAYS">
                    <VBox spacing="14" styleClass="board-panel" HBox.hgrow="ALWAYS">
                        <VBox spacing="8" styleClass="market-band">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Mercato superiore" styleClass="panel-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="clicca una carta" styleClass="micro-pill"/>
                            </HBox>
                            <ScrollPane fitToHeight="true" fitToWidth="false" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="row-scroll">
                                <HBox fx:id="upperRowContainer" spacing="12" styleClass="card-row"/>
                            </ScrollPane>
                        </VBox>
                        <VBox spacing="8" styleClass="market-band">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Mercato inferiore" styleClass="panel-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="scelta + pesca" styleClass="micro-pill"/>
                            </HBox>
                            <ScrollPane fitToHeight="true" fitToWidth="false" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="row-scroll">
                                <HBox fx:id="lowerRowContainer" spacing="12" styleClass="card-row"/>
                            </ScrollPane>
                        </VBox>
                        <VBox spacing="8" styleClass="offer-band">
                            <Label text="Percorso offerta" styleClass="panel-title"/>
                            <HBox fx:id="offerPathContainer" spacing="10"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="14" minWidth="318" prefWidth="340">
                        <VBox spacing="10" styleClass="surface-panel">
                            <Label text="Giocatori" styleClass="panel-title"/>
                            <VBox fx:id="playerListContainer" spacing="10"/>
                        </VBox>
                        <VBox spacing="10" styleClass="surface-panel action-panel">
                            <Label text="Azioni turno" styleClass="panel-title-large"/>
                            <Label fx:id="selectedCardLabel" text="Nessuna carta selezionata" wrapText="true" styleClass="status-text"/>
                            <HBox spacing="8">
                                <Button text="A" onAction="#handleMoveTotemA" styleClass="tile-button"/>
                                <Button text="B" onAction="#handleMoveTotemB" styleClass="tile-button"/>
                                <Button text="C" onAction="#handleMoveTotemC" styleClass="tile-button"/>
                            </HBox>
                            <Button text="Scegli carta" onAction="#handleChooseCard" maxWidth="Infinity" styleClass="primary-button"/>
                            <Button text="Pesca extra" onAction="#handleExtraDraw" maxWidth="Infinity" styleClass="secondary-button"/>
                        </VBox>
                    </VBox>
                </HBox>

                <VBox spacing="8" styleClass="surface-panel tribe-panel">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Tribu" styleClass="panel-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="carte personali" styleClass="micro-pill"/>
                    </HBox>
                    <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER" styleClass="row-scroll">
                        <HBox fx:id="tribeCardsContainer" spacing="10"/>
                    </ScrollPane>
                </VBox>
            </VBox>

            <VBox fx:id="endPage" alignment="CENTER" spacing="22" styleClass="page end-page">
                <VBox alignment="CENTER" spacing="4">
                    <Label text="Partita conclusa" styleClass="hero-title"/>
                    <Label text="Classifica mock integrata in attesa del ranking reale." styleClass="hero-copy"/>
                </VBox>
                <VBox fx:id="finalRankingContainer" spacing="10" maxWidth="560" styleClass="surface-panel final-panel"/>
                <Button text="Torna alle lobby" onAction="#handleBackToLobby" styleClass="primary-button"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
